NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_replace_me

# Sentry (optional — leave empty to disable)
VITE_SENTRY_DSN=
# For source map uploads on build (do not commit real token)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...

# Auth hardening
NEXT_PUBLIC_AUTH_CAPTCHA_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me

# Optional MCP relay integration for canvas agent sync
# Default behavior in production is disabled unless this is set to true.
NEXT_PUBLIC_ENABLE_MCP_RELAY=false

# Optional override for relay host/base path.
# Accepted formats: https://app.example.com, wss://app.example.com, https://app.example.com/relay
# Leave blank to use same-origin /canvas-sync and /agent-relay endpoints.
# NEXT_PUBLIC_MCP_RELAY_URL=

# Optional agent debug log ingest endpoint.
# Leave unset unless you are running a local/debug collector.
# NEXT_PUBLIC_AGENT_LOG_INGEST_URL=http://127.0.0.1:7785/ingest/<session-id>
# NEXT_PUBLIC_AGENT_LOG_SESSION_ID=local-debug

# Supabase Function secrets (set in Supabase, not committed in frontend env files)
GITHUB_APP_SLUG=replace_me
GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
APP_PUBLIC_URL=https://your-app-origin.example

# AI Providers
# Gemini 2.5 Flash Lite is used for transcript-flow-map diagram extraction
GEMINI_API_KEY=replace_me

# Groq (preferred) / OpenAI (fallback) for prompt assembly and repair
GROQ_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENAI_TRANSCRIPT_MODEL=gpt-5-nano
OPENAI_TRANSCRIPT_TEMPERATURE=default

# Notifications / Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=billing@spoqen.com

# Stripe subscription billing (set in Supabase secrets, not committed)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_INDIVIDUAL_PRICE_ID=price_...
# STRIPE_GROWTH_PRICE_ID=price_...
# STRIPE_ENTERPRISE_PRICE_ID=price_...

